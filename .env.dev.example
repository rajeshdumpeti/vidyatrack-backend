# VidyaTrack development environment
# Copy to `.env` for local development or to Render dev service variables.

APP_NAME=vidyatrack-backend
APP_ENV=dev
DEBUG=true

# Dev maps to the Neon development database.
DATABASE_URL_DEV=postgresql+psycopg://<neon-dev-user>:<password>@<neon-dev-host>/<database>?sslmode=require

JWT_SECRET=replace_with_a_long_random_value
OTP_PEPPER=replace_with_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_DELIVERY_MODE=local_log_only
OTP_DEBUG_LOG_PLAINTEXT=true

# Small pool keeps free-tier/shared environments efficient.
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE_SECONDS=900

# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANG=en_US
# WHATSAPP_WABA_ID=

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VidyaTrack
BREVO_OTP_SUBJECT=Your VidyaTrack OTP

# STRAPI_BASE_URL=http://localhost:1337/api
# STRAPI_API_TOKEN=
# STRAPI_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vidyatrack-dev.vercel.app
