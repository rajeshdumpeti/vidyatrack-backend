# VidyaTrack Backend - Environment Variables

# Application metadata
APP_NAME=vidyatrack-backend

# Environment: dev | test | stage | pilot | prod
ENVIRONMENT=dev

# Debug mode (true for dev, false for stage/pilot/prod)
DEBUG=true

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vidyatrack
DB_USER=vidyatrack
DB_PASSWORD=VidyaTrackDev_2025

# WhatsApp Cloud API (pilot-safe)
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_TIMEOUT_SECONDS=10

#stage / pilot / prod
# DB_PASSWORD=qoA05UbCYFtLnEc5Ft8ZWrOWYabysWcz

# Auth / Security (set per environment; do NOT commit real values)
JWT_SECRET=change_me_to_a_long_random_value
OTP_PEPPER=change_me_to_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
