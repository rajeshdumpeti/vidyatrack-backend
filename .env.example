# VidyaTrack Backend - Environment Variables

# Application metadata
APP_NAME=vidyatrack-backend

# Environment: dev | test | stage | pilot | prod
ENVIRONMENT=dev

# Debug mode (true for dev, false for stage/pilot/prod)
DEBUG=true

# Database (PostgreSQL)clear
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vidyatrack
DB_USER=vidyatrack
DB_PASSWORD=VidyaTrackDev_2025

#stage / pilot / prod
# DB_PASSWORD=qoA05UbCYFtLnEc5Ft8ZWrOWYabysWcz

# Auth / Security (set per environment; do NOT commit real values)
JWT_SECRET=change_me_to_a_long_random_value
OTP_PEPPER=change_me_to_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
# OTP delivery mode:
# provider       -> send via WhatsApp, fallback to email
# email_only     -> send OTP only via email (Brevo)
# local_log_only -> skip provider calls and print OTP in backend terminal logs
# OTP_DELIVERY_MODE=provider
# OTP_DELIVERY_MODE=local_log_only
OTP_DELIVERY_MODE=email_only

# Dev-only: when true, logs plaintext OTP in backend logs for local testing.
OTP_DEBUG_LOG_PLAINTEXT=true

# WhatsApp Cloud API (OTP delivery)
WHATSAPP_ACCESS_TOKEN=replace_with_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=replace_with_meta_phone_number_id
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OTP_TEMPLATE_NAME=replace_with_otp_template_name
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_WABA_ID=replace_with_meta_weba_id

# Brevo Email API (OTP fallback when WhatsApp fails)
BREVO_API_KEY=replace_with_brevo_api_key
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=VidyaTrack
BREVO_OTP_SUBJECT=Your VidyaTrack OTP

# Strapi CMS
STRAPI_BASE_URL=http://localhost:1337/api
STRAPI_API_TOKEN=replace_with_strapi_custom_api_token
STRAPI_TIMEOUT_SECONDS=10

# Comma-separated frontend origins allowed by CORS
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vidyatrack-dev.vercel.app
