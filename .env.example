# VidyaTrack Backend - generic template
#
# Recommended workflow:
# 1. Copy `.env.dev.example`, `.env.stage.example`, or `.env.prod.example`
# 2. Save it locally as `.env`
# 3. Fill in real secrets outside git
#
# The backend automatically picks the right database using:
# - `APP_ENV=dev`   -> `DATABASE_URL_DEV`
# - `APP_ENV=stage` -> `DATABASE_URL_STAGE`
# - `APP_ENV=prod`  -> `DATABASE_URL_PROD`
#
# `DATABASE_URL` can still be set as an explicit override for one-off commands.

APP_NAME=vidyatrack-backend
APP_ENV=dev
DEBUG=true

# Optional one-off override for local scripts:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/db_name
DATABASE_URL_DEV=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/vidyatrack_dev
DATABASE_URL_STAGE=
DATABASE_URL_PROD=

# Local fallback for `APP_ENV=dev` when DATABASE_URL_DEV is intentionally blank.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=vidyatrack_dev
DB_USER=postgres
DB_PASSWORD=postgres

# Pool tuning. Leave blank to use safe defaults per environment.
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_TIMEOUT=
DB_POOL_RECYCLE_SECONDS=

JWT_SECRET=replace_with_a_long_random_value
OTP_PEPPER=replace_with_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_DELIVERY_MODE=local_log_only
OTP_DEBUG_LOG_PLAINTEXT=true

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_WABA_ID=

BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VidyaTrack
BREVO_OTP_SUBJECT=Your VidyaTrack OTP

STRAPI_BASE_URL=http://localhost:1337/api
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vidyatrack-dev.vercel.app
