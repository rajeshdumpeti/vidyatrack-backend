# VidyaTrack production environment
# Copy to `.env` only for controlled production maintenance tasks.

APP_NAME=vidyatrack-backend
APP_ENV=prod
DEBUG=false

# Prod maps to the Render PostgreSQL database.
DATABASE_URL_PROD=postgresql+psycopg://<render-user>:<password>@<render-host>/<database>?sslmode=require

JWT_SECRET=replace_with_a_long_random_value
OTP_PEPPER=replace_with_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_DELIVERY_MODE=provider
OTP_DEBUG_LOG_PLAINTEXT=false

# Production gets the largest pool, but still stays modest for small instances.
DB_POOL_SIZE=8
DB_MAX_OVERFLOW=8
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE_SECONDS=1500

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v22.0
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=en_US
WHATSAPP_WABA_ID=

BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VidyaTrack
BREVO_OTP_SUBJECT=Your VidyaTrack OTP

STRAPI_BASE_URL=https://cms.vidyatrack.example.com/api
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=https://api.vidyatrack.example.com,https://app.vidyatrack.example.com
