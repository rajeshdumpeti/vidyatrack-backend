# VidyaTrack staging / UAT environment
# Copy to `.env` for local staging validation or add the same variables to Render stage.

APP_NAME=vidyatrack-backend
APP_ENV=stage
DEBUG=false

# Stage maps to the Neon staging database.
DATABASE_URL_STAGE=postgresql+psycopg://<neon-stage-user>:<password>@<neon-stage-host>/<database>?sslmode=require

JWT_SECRET=replace_with_a_long_random_value
OTP_PEPPER=replace_with_a_long_random_value
JWT_TTL_MINUTES=30
OTP_TTL_MINUTES=5
OTP_DELIVERY_MODE=provider
OTP_DEBUG_LOG_PLAINTEXT=false

DB_POOL_SIZE=4
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=20
DB_POOL_RECYCLE_SECONDS=1200

# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_API_VERSION=v22.0
# WHATSAPP_OTP_TEMPLATE_NAME=
# WHATSAPP_OTP_TEMPLATE_LANG=en_US
# WHATSAPP_WABA_ID=

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

BREVO_API_KEY=
BREVO_API_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=VidyaTrack
BREVO_OTP_SUBJECT=Your VidyaTrack OTP

STRAPI_BASE_URL=https://cms-stage.example.com/api
STRAPI_API_TOKEN=
STRAPI_TIMEOUT_SECONDS=10

CORS_ALLOW_ORIGINS=https://vidyatrack-stage.vercel.app/
